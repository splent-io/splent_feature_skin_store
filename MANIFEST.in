# Skin stylesheet (served by the blueprint asset route)
recursive-include src/splent_io/splent_feature_skin_store/assets *.js *.css *.map

# Jinja templates (feature views + hook fragments)
recursive-include src/splent_io/splent_feature_skin_store/templates *.html

# Alembic migration config and scripts
recursive-include src/splent_io/splent_feature_skin_store/migrations *.py *.ini *.mako
